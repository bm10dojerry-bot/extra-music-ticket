+import { NextRequest, NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { getActor, getStaff, STAFF_COOKIE, staffDb } from "../../../../lib/staff-auth";
+import { getMessengerConfig } from "../../../../lib/facebook-messenger";
+import { proRpc, proStatus } from "../../../../lib/ai-sale-pro/database";
+import { resolveHandoff, type HandoffStatus } from "../../../../lib/ai-sale-pro/operator";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const reply = (body: unknown, status = 200) => NextResponse.json(body, { status, headers: { "Cache-Control": "no-store" } });
+
+async function scopedChat(chatId: string, pageId: string) {
+  const rows = await staffDb("extra_support_chats?id=eq." + chatId + "&channel=eq.messenger&messenger_page_id=eq." +
+    pageId + "&select=id,assigned_staff_id&limit=1") as { id: string; assigned_staff_id: string | null }[];
+  return rows[0] ?? null;
+}
+
+async function operatorScope(staffId?: string) {
+  if (!staffId || !uuid.test(staffId)) return null;
+  const rows = await staffDb("extra_sale_pro_operators?staff_id=eq." + staffId +
+    "&select=can_resolve_any&limit=1") as { can_resolve_any: boolean }[];
+  return rows[0] ?? null;
+}
+
+export async function GET(req: NextRequest) {
+  const id = req.nextUrl.searchParams.get("chatId");
+  if (!id || !uuid.test(id)) return reply({ error: "Mã hội thoại không hợp lệ." }, 400);
+  try {
+    const jar = await cookies();
+    const [actor, operator] = await Promise.all([getActor(), getStaff(jar.get(STAFF_COOKIE)?.value)]);
+    if (!actor || !["admin", "sale"].includes(actor.role)) return reply({ error: "Cần đăng nhập." }, 403);
+    const page = getMessengerConfig()?.pageId;
+    if (!page) return reply({ error: "Messenger chưa có cấu hình." }, 503);
+    const [chat, scope] = await Promise.all([scopedChat(id, page), operatorScope(operator?.id)]);
+    if (!chat || (actor.role === "sale" && chat.assigned_staff_id !== actor.id && !scope?.can_resolve_any)) {
+      return reply({ error: "Không tìm thấy hội thoại được cấp quyền." }, 404);
+    }
+    const [handoff, mode] = await Promise.all([
+      proRpc<HandoffStatus>("status", { p_chat_id: id, p_page_id: page }),
+      proStatus(page),
+    ]);
+    const canResolve = Boolean(operator && ["admin", "sale"].includes(operator.role) &&
+      scope && (scope.can_resolve_any || chat.assigned_staff_id === operator.id));
+    if (actor.role !== "admin" || !handoff.id) return reply({ handoff, mode, canResolve });
+    const [audit, dispatches, notice] = await Promise.all([
+      staffDb("extra_sale_pro_resolution_audit?handoff_id=eq." + handoff.id +
+        "&select=staff_id,outcome,recorded_at&order=recorded_at.desc&limit=20"),
+      staffDb("extra_sale_pro_dispatches?chat_id=eq." + id +
+        "&select=purpose,status,started_at,finished_at&order=started_at.desc&limit=20"),
+      staffDb("extra_sale_pro_delivery?handoff_id=eq." + handoff.id +
+        "&select=state,created_at,finished_at&limit=1"),
+    ]);
+    return reply({ handoff, mode, canResolve, audit, dispatches, notice });
+  } catch {
+    return reply({ error: "Chưa đọc được trạng thái bàn giao." }, 503);
+  }
+}
+
+export async function POST(req: NextRequest) {
+  const origin = req.headers.get("origin");
+  if (!origin || origin !== req.nextUrl.origin) return reply({ error: "Nguồn yêu cầu không hợp lệ." }, 403);
+  if (Number(req.headers.get("content-length") || 0) > 2048) return reply({ error: "Yêu cầu quá lớn." }, 413);
+  try {
+    const jar = await cookies();
+    const operator = await getStaff(jar.get(STAFF_COOKIE)?.value);
+    if (!operator || !["admin", "sale"].includes(operator.role)) return reply({ outcome: "forbidden" }, 403);
+    const raw = await req.text();
+    if (raw.length > 2048) return reply({ error: "Yêu cầu quá lớn." }, 413);
+    let input: Record<string, unknown>;
+    try { input = JSON.parse(raw); } catch { return reply({ outcome: "invalid" }, 400); }
+    if (!input || typeof input.chatId !== "string" || !uuid.test(input.chatId)) return reply({ outcome: "invalid" }, 400);
+    const page = getMessengerConfig()?.pageId;
+    if (!page) return reply({ error: "Messenger chưa có cấu hình." }, 503);
+    if (!await scopedChat(input.chatId, page)) return reply({ outcome: "forbidden" }, 403);
+    const result = await resolveHandoff(input, operator);
+    const status = ["paid", "unpaid"].includes(result.outcome) ? 200 :
+      result.outcome === "forbidden" ? 403 : result.outcome === "invalid" ? 400 : 409;
+    return reply(result, status);
+  } catch {
+    return reply({ error: "Chưa xác minh được yêu cầu. Khóa vẫn được giữ." }, 503);
+  }
+}

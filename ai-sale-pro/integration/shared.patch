+"use client";
+import { useEffect, useState, type FormEvent } from "react";
+import { isResolutionCommand, reasonLabels, type HandoffReason } from "../lib/ai-sale-pro/policy";
+import type { HandoffStatus } from "../lib/ai-sale-pro/operator";
+
+type Detail = {
+  handoff: HandoffStatus;
+  canResolve: boolean;
+  notice?: { state: string }[];
+  audit?: { staff_id: string; outcome: string; recorded_at: string }[];
+  dispatches?: { purpose: string; status: string; started_at: string }[];
+};
+
+const outcomeLabels: Record<string, string> = {
+  paid: "Đã xác nhận khách đã thanh toán. Dừng lời mời mua vé.",
+  unpaid: "Đã xử lý xong. Bộ quét tiếp tục theo điều kiện chăm sóc hiện có.",
+  payment_unknown: "Chưa xác định được thanh toán. Hội thoại vẫn khóa.",
+  in_flight: "Còn lượt gửi đang được xác minh. Vui lòng kiểm tra lại.",
+  forbidden: "Tài khoản này chưa được cấp quyền xác nhận bàn giao.",
+  stale: "Mục bàn giao đã thay đổi. Vui lòng tải lại hội thoại.",
+  replay: "Lệnh này đã được ghi nhận.",
+};
+const dispatchLabels: Record<string, string> = {
+  sending: "Đang gửi", skipped: "Đã chặn", sent: "Đã gửi", failed: "Bị từ chối",
+  uncertain: "Chưa có biên nhận", queued: "Đang chờ gửi",
+};
+const purposeLabels: Record<string, string> = {
+  reply: "Trả lời", checkout: "Đặt vé", ticket: "Giao vé", followup: "Nhắc khách",
+  before_show_paid: "Nhắc lịch", manual_timeout: "Nhắc chờ", seat_map: "Ảnh sơ đồ", comment_reply: "Tin tư vấn từ bình luận",
+};
+const time = new Intl.DateTimeFormat("vi-VN", {
+  dateStyle: "short", timeStyle: "short", timeZone: "Asia/Ho_Chi_Minh",
+});
+
+export default function HandoffPanel({ chatId }: { chatId: string }) {
+  const [detail, setDetail] = useState<Detail>();
+  const [command, setCommand] = useState("");
+  const [status, setStatus] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [refresh, setRefresh] = useState(0);
+  useEffect(() => {
+    const controller = new AbortController();
+    const load = () => void fetch("/api/staff/ai-sale-pro?chatId=" + encodeURIComponent(chatId),
+      { cache: "no-store", signal: controller.signal })
+      .then(async result => {
+        if (result.ok && !controller.signal.aborted) {
+          const next = await result.json() as Detail;
+          if (!controller.signal.aborted) setDetail(next);
+        }
+      })
+      .catch(() => {});
+    load();
+    const timer = setInterval(load, 15_000);
+    return () => { controller.abort(); clearInterval(timer); };
+  }, [chatId, refresh]);
+
+  const handoff = detail?.handoff;
+  if (!handoff?.id) return null;
+  const reason = reasonLabels[handoff.reason as HandoffReason] || "Cần nhân viên kiểm tra";
+  const open = !handoff.resolved_at;
+
+  async function resolve(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (busy || !handoff?.id || !isResolutionCommand(command)) return;
+    setBusy(true);
+    try {
+      const response = await fetch("/api/staff/ai-sale-pro", {
+        method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ chatId, handoffId: handoff.id, eventId: crypto.randomUUID(), issuedAt: new Date().toISOString(), command }),
+      });
+      const data = await response.json();
+      setStatus(outcomeLabels[data.outcome] || data.error || "Chưa xác minh được lệnh.");
+      if (response.ok) setCommand("");
+      setRefresh(value => value + 1);
+    } catch {
+      setStatus("Chưa đọc được kết quả. Kiểm tra lại trạng thái bàn giao.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <section aria-label="Bàn giao AI Sale" className="extra-inbox-queue-intro">
+      <p><strong>{open ? "Đang khóa AI" : "Đã xử lý bàn giao"}</strong> · {reason}
+        {handoff.opened_at ? " · " + time.format(new Date(handoff.opened_at)) : ""}
+      </p>
+      {detail?.notice?.length ? <p>Thông báo Trang · {dispatchLabels[detail.notice[0].state]}</p> : null}
+      {handoff.in_flight ? <p>Đang xác minh lượt gửi đã bắt đầu.</p> : null}
+      {open && detail?.canResolve ? (
+        <form className="extra-inbox-reply" onSubmit={resolve}>
+          <label htmlFor="extra-sale-pro-command">Lệnh nội bộ · Đã xử lý xong</label>
+          <input id="extra-sale-pro-command" value={command} maxLength={120} onChange={event => setCommand(event.target.value)} />
+          <button type="submit" disabled={busy || handoff.in_flight || !isResolutionCommand(command)}>Xác nhận xử lý</button>
+        </form>
+      ) : null}
+      {status ? <p role="status">{status}</p> : null}
+      {detail?.audit || detail?.dispatches ? (
+        <details>
+          <summary>Lịch sử bàn giao và gửi</summary>
+          <ul>
+            {detail.audit?.map(item => <li key={item.recorded_at + item.staff_id}>
+              {time.format(new Date(item.recorded_at))} · {item.staff_id} · {outcomeLabels[item.outcome]}
+            </li>)}
+            {detail.dispatches?.map(item => <li key={item.started_at + item.purpose}>
+              {time.format(new Date(item.started_at))} · {purposeLabels[item.purpose]} · {dispatchLabels[item.status]}
+            </li>)}
+          </ul>
+        </details>
+      ) : null}
+    </section>
+  );
+}
